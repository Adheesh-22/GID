<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SPEC §7 permissions -->
    <!-- Network access for Supabase (sign-in + the profile row only) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms. An alarm-clock app may also use USE_EXACT_ALARM, which
         Android grants automatically, so alarms ring on time from install. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Ringing screen over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Re-arm alarms after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Foreground service that plays the alarm sound -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Lets Settings > Reliability ask to be exempt from battery optimisation -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".GIDApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GID">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Email confirmation and password reset links from Supabase -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.adheesh.gid" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Full-screen ringing screen, shown over the lock screen -->
        <activity
            android:name=".core.scheduling.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true"
            tools:targetApi="27" />

        <!-- Plays the alarm; the type tells Android what the foreground work is -->
        <service
            android:name=".core.scheduling.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver android:name=".core.scheduling.AlarmReceiver" android:exported="false" />
        <receiver android:name=".core.scheduling.TimerReceiver" android:exported="false" />
        <receiver android:name=".core.scheduling.ClassReminderReceiver" android:exported="false" />
        <receiver android:name=".core.scheduling.EveningPromptReceiver" android:exported="false" />
        <receiver android:name=".core.scheduling.SessionActionReceiver" android:exported="false" />

        <!-- Re-plans every alarm after reboot, clock / time-zone change and app update -->
        <receiver
            android:name=".core.scheduling.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
